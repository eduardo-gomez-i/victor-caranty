// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")
  phone         String?
  location      Json?
  role          Role      @default(SELLER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  vehicles      Vehicle[]
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                 String  @id @default(uuid())
  userId             String  @map("user_id")
  type               String
  provider           String  @db.VarChar(50)
  providerAccountId  String  @map("provider_account_id") @db.VarChar(190)
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token") @db.VarChar(190)
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String   @db.VarChar(100)
  token      String   @db.VarChar(100)
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Role {
  SELLER
  ADMIN
}

model Vehicle {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  make        String
  model       String
  version     String?  @db.VarChar(100)
  invoiceType String?  @map("invoice_type") @db.VarChar(50)
  transmission String? @db.VarChar(20)
  year        Int
  mileage     Int
  price       Decimal  @db.Decimal(10, 2)
  description String?  @db.Text
  type        String?  @db.VarChar(50)
  // active, sold, paused, pending (revisión del admin), reviewing (revisión automática de fotos), rejected
  status      String   @default("active")
  // Motivos por los que la publicación automática se detuvo y pasó a revisión del admin
  moderationFlags Json? @map("moderation_flags")
  state       String?  @db.VarChar(50)
  location    Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  images  Image[]

  @@index([make])
  @@index([price])
  @@index([year])
  @@index([isActive])
  @@index([state])
  @@index([userId])
  @@map("vehicles")
}

model Image {
  id           String   @id @default(uuid())
  vehicleId    String   @map("vehicle_id")
  url          String   @db.VarChar(500)
  displayOrder Int      @default(0) @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  // Oculta al público hasta que un admin la apruebe (foto ajena al auto, datos de contacto, error de la IA…)
  hidden       Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([isPrimary])
  @@map("images")
}

// Equipamiento por versión. verified=true cuando un admin aprobó un anuncio con esa ficha.
model VehicleSpec {
  id        String   @id @default(uuid())
  specKey   String   @unique @map("spec_key") @db.VarChar(190)
  make      String   @db.VarChar(60)
  model     String   @db.VarChar(80)
  version   String   @db.VarChar(100)
  year      Int
  tagline   String?  @db.VarChar(200)
  features  Json
  sources   Json?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vehicle_specs")
}

// Procesamiento de fotos con IA (placa de marca, quitar personas y objetos).
// Se liga a la foto por URL porque las imágenes de un vehículo se recrean al editarlo.
model PhotoJob {
  id           String   @id @default(uuid())
  // sha256 de originalUrl: la URL puede pasar el límite de índice de MySQL
  urlKey       String   @unique @map("url_key") @db.VarChar(64)
  originalUrl  String   @map("original_url") @db.VarChar(500)
  processedUrl String?  @map("processed_url") @db.VarChar(500)
  // pending | processing | ready | approved | original | unchanged | failed
  status       String   @default("pending") @db.VarChar(20)
  plateFound   Boolean  @default(false) @map("plate_found")
  removedItems Json?    @map("removed_items")
  // % de la foto reconstruido por la IA; alto = revisar con cuidado
  replacedPct  Float?   @map("replaced_pct")
  // Retoques opcionales pedidos por el admin: { clean: limpiar suciedad suelta, deglare: reducir destello del sol }
  options      Json?
  // Lo que la detección sugiere ofrecer: { dirt, glare, interior }
  suggestions  Json?
  // Problemas de contenido en la foto (datos de contacto, marcas de agua, no es un auto…); detienen la publicación automática
  flags        Json?
  costUsd      Decimal? @map("cost_usd") @db.Decimal(10, 5)
  attempts     Int      @default(0)
  error        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("photo_jobs")
}
